    listings = {l["id"]: l for l in await db.listings.find({"id": {"$in": [p["listing_id"] for p in items]}}, {"_id": 0}).to_list(300)}
    for p in items:
        l = listings.get(p["listing_id"], {})
        p["preview"] = media_url((l.get("preview_file_ids") or [None])[0])
        ids = p.get("delivery_file_ids", []) if p["kind"] == "custom" else l.get("content_file_ids", [])
        p["files"] = await file_infos(ids) if p["status"] in ("paid", "delivered") else []
    return items




async def can_access(m: dict, fid: str) -> bool:
    f = await db.files.find_one({"id": fid, "is_deleted": False}, {"_id": 0, "owner_id": 1})
    if not f:
        return False
    if f["owner_id"] == m["user_id"]:
        return True
    for l in await db.listings.find({"content_file_ids": fid}, {"_id": 0, "id": 1, "price": 1, "status": 1}).to_list(50):
        if l["price"] == 0 and l["status"] == "live":
            return True
        if await db.purchases.find_one({"listing_id": l["id"], "client_id": m["user_id"], "status": "paid"}, {"_id": 1}):
            return True
    return bool(await db.purchases.find_one({"delivery_file_ids": fid, "client_id": m["user_id"], "status": "delivered"}, {"_id": 1}))




