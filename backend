async def store_upload(m: dict, f: UploadFile, purpose: str, allowed: dict) -> dict:
    ext = allowed.get(f.content_type or "")
    if not ext:
        raise HTTPException(400, "Unsupported file type")
    data = await f.read()
    if len(data) > MAX_BYTES:
        raise HTTPException(400, "File is larger than 10 MB")
    fid = new_id()
    folder = "private/verification" if purpose != "photo" else "public/photos"
    res = await run_in_threadpool(put_object, f"{APP_NAME}/{folder}/{m['user_id']}/{fid}.{ext}", data, f.content_type)
    doc = {"id": fid, "owner_id": m["user_id"], "purpose": purpose, "storage_path": res["path"],
           "content_type": f.content_type, "original_filename": (f.filename or "")[:120], "size": len(data),
           "is_deleted": False, "created_at": now_iso()}
    await db.files.insert_one(dict(doc))
    return doc




