(".dash-section").forEach(s=>s.classList.toggle("active",s.id==="dash-"+key));const labels={overview:["Good evening, Luna.","Your profile is in good shape. Here's your latest snapshot."],profileEdit:["Edit your public profile","Keep your public profile clear, accurate, and within your boundaries."],contacts:["Contact access settings","Choose public, token-locked, or private for each method."],earnings:["Earnings & payouts","Transparent earnings, review holds, and payout history."],compliments:["Compliments","Four positive tags, no star ratings, and no public written reviews."],referrals:["Your referrals","Invite clients and eligible creators to Moon & Muse."],notifications:["Notifications","Essential account updates and optional announcements."],settings:["Account settings","Manage visibility, preferences, and account security."]};("#dashHeading").textContent=labels[key][0];("#dashSub").textContent=labels[key][1];if(key==="contacts")updateContactSettings()}
function showConfirmUnlock(p,id){const c=p.contacts[Number(id)],key=p.id+":"+id;if(unlocked.has(key)){toast("This contact is already unlocked on this preview account.");return}openModal(`<div class="eyebrow">Confirm contact unlock</div><h2 id="modalTitle">Unlock c.name?</h2><p>Reviewthecostandaccesstermsbeforespendingtokens.</p><divclass="confirm-details"><div><span>Creator</span><strong>{p.name}</strong></div><div><span>Contact method</span><strong>c.name</strong></div><div><span>Tokencost</span><strong>{c.price} tokens</strong></div><div><span>Your balance</span><strong>tokens.purchased+tokens.promotokens</strong></div><div><span>Accesspolicy</span><strong>Availablewhiletheprofileisvisible</strong></div></div><pclass="tiny">Thisisademounlock.Realpurchasesrequireserver-confirmedpaymentandledgerupdates.Hidingordeletingaprofilecanmakecontactinformationunavailable.</p><divclass="hero-actions"><buttonclass="btnbtn-primaryfull-width"data-action="confirmUnlock"data-id="{p.id}" data-contact="${id}">Confirm and spend ${c.price} tokens</button><button class="btn btn-secondary full-width" data-action="closeModal">Cancel</button></div>`)}
function doUnlock(id,contact){const p=profiles.find(x=>x.id===Number(id)),c=p.contacts[Number(contact)],key=p.id+":"+contact;let cost=c.price;if(tokens.promo+tokens.purchased<cost){closeModal();openModal(`<div class="eyebrow">Not enough tokens</div><h2 id="modalTitle">Top up your wallet</h2><p>You need ${cost} tokens but have tokens.purchased+tokens.promo.Chooseasamplepacktocontinue.</p><divclass="hero-actions"><buttonclass="btnbtn-primary"data-action="buy"data-tokens="100"data-price="10">100 tokens · $10</button><button class="btn btn-secondary" data-action="closeModal">Not now</button></div>`);return}if(tokens.promo>=cost){tokens.promo-=cost}else{const remaining=cost-tokens.promo;tokens.promo=0;tokens.purchased-=remaining}unlocked.add(key);$("#walletActivity").insertAdjacentHTML("afterbegin",`<tr><td>Contact unlock · p.name</td><td>-{cost}</td><td><span class="status">Demo</span></td></tr>`);updateWallet();closeModal();openProfile(p.id);toast("Demo unlock complete. No real payment was made.")}
function handleAction(btn){const a=btn.dataset.action,id=btn.dataset.id;
if(a==="auth")authModal(btn.dataset.role||"client","signup");
if(a==="closeModal")closeModal();
if(a==="switchAuth")authModal(btn.dataset.role||"client",btn.dataset.mode);
if(a==="roleTab")authModal(btn.dataset.role,"signup");
if(a==="viewProfile")openProfile(id);
if(a==="favorite"){const n=Number(id);if(saved.has(n)){saved.delete(n);toast("Removed from your private favorites.")}else{saved.add(n);toast("Saved to your private favorites.")}if(currentPage==="profile")$("#profileHeart").textContent=saved.has(currentProfile.id)?"♥":"♡";if(currentPage==="favorites")renderFavorites();else if(currentPage==="directory")renderDirectory();else renderCards("#featuredCreators",profiles.slice(0,3))}
if(a==="unlock")showConfirmUnlock(profiles.find(p=>p.id===Number(id)),btn.dataset.contact);
if(a==="confirmUnlock")doUnlock(id,btn.dataset.contact);
if(a==="buy"){const n=Number(btn.dataset.tokens);openModal(`<div class="eyebrow">Token pack</div><h2 id="modalTitle">Add ${n} tokens?</h2><p>Sample pack price: btn.dataset.price.Paymentprocessingisnotconnectedinthispreview.</p><divclass="confirm-details"><div><span>Tokens</span><strong>{n}</strong></div><div><span>Price</span><strong>btn.dataset.price</strong></div><div><span>Paymentstatus</span><strong>Demoonly</strong></div></div><buttonclass="btnbtn-primaryfull-width"style="margin-top:18px"data-action="confirmBuy"data-tokens="{n}">Simulate successful payment</button><button class="btn btn-quiet full-width" data-action="closeModal">Cancel</button>`)}
if(a==="confirmBuy"){const n=Number(btn.dataset.tokens);tokens.purchased+=n;updateWallet();closeModal();toast("Demo tokens added. No payment was taken.")}
if(a==="compliment"){const p=profiles.find(x=>x.id===Number(id)),contact=Number(btn.dataset.contact);openModal(`<div class="eyebrow">A little appreciation</div><h2 id="modalTitle">Send a compliment</h2><p>Choose the positive tags that fit. Your identity won't be shown publicly, and submitted compliments are final.</p><form id="complimentForm" data-id="p.id"data-contact="{contact}"><label class="checkline"><input type="checkbox" name="tag" value="Professional"><span><strong>Professional</strong> — businesslike and professional</span></label><label class="checkline"><input type="checkbox" name="tag" value="Friendly"><span><strong>Friendly</strong> — warm and welcoming</span></label><label class="checkline"><input type="checkbox" name="tag" value="Responsive"><span><strong>Responsive</strong> — attentive communication</span></label><label class="checkline"><input type="checkbox" name="tag" value="Authentic"><span><strong>Authentic</strong> — genuine profile and presence</span></label><button class="btn btn-primary full-width" type="submit">Submit compliment</button></form><div class="modal-message" id="complimentMessage"></div><p class="fineprint">One compliment submission per qualifying purchase. This preview records only sample browser state.</p>`)}
if(a==="report")openModal(`<div class="eyebrow">Safety & moderation</div><h2 id="modalTitle">Report this profile</h2><p>Reports are reviewed; a report alone is not proof of misconduct. Serious credible concerns may trigger temporary restrictions.</p><form id="reportForm"><label class="label">Reason<select class="select" required><option value="">Choose a reason</option><option>Impersonation</option><option>Suspected age eligibility issue</option><option>Fraud or misleading information</option><option>Compromised account</option><option>Other concern</option></select></label><label class="label">Details<textarea class="textarea" rows="3" placeholder="Share only information relevant to the report"></textarea></label><button class="btn btn-primary full-width">Submit demo report</button></form><div class="modal-message" id="reportMessage"></div>`);
if(a==="viewOwnProfile")openProfile(1);
if(a==="hideProfile"){profileVisible=!profileVisible;btn.textContent=profileVisible?"Hide profile":"Restore profile";$("#profileVisibleSwitch").checked=profileVisible;toast(profileVisible?"Your sample profile is visible again.":"Your sample profile is hidden. Contact details are unavailable while hidden.")}
if(a==="saveContacts"){document.querySelectorAll("[data-contact-mode]").forEach(el=>profiles[0].contacts[Number(el.dataset.contactMode)].mode=el.value);document.querySelectorAll("[data-contact-price]").forEach(el=>profiles[0].contacts[Number(el.dataset.contactPrice)].price=Math.max(1,Number(el.value)||1));toast("Demo contact settings saved.");}
if(a==="copy"){const val=$("#"+btn.dataset.copy).value;navigator.clipboard?.writeText(val).then(()=>toast("Referral link copied.")).catch(()=>toast("Preview link: "+val));}
if(a==="loginHistory")openModal(`<div class="eyebrow">Account security</div><h2 id="modalTitle">Recent sign-ins</h2><p>Approximate IP-based locations can be inaccurate. This is sample data only.</p><div class="confirm-details"><div><span>Today · 9:42 PM</span><strong>Current browser · Kansas City, MO (approx.)</strong></div><div><span>Oct 21 · 6:13 PM</span><strong>Desktop browser · Location unavailable</strong></div></div>`);
if(a==="deactivate")openModal(`<div class="eyebrow">Take a break</div><h2 id="modalTitle">Deactivate account?</h2><p>Your account and saved information are preserved. Referral codes pause for new referrals; existing eligible referrals remain tracked. Reactivate later through a secure sign-in flow.</p><button class="btn btn-primary full-width" style="margin-top:20px" data-action="confirmDeactivate">Simulate deactivation</button>`);
if(a==="confirmDeactivate"){closeModal();toast("Preview only: deactivation is not connected to an account backend.");}
if(a==="deleteAccount")openModal(`<div class="eyebrow">Permanent action</div><h2 id="modalTitle">Review account deletion</h2><p>Permanent deletion removes your profile and contact information. Eligible earnings and referral rewards remain subject to normal checks; financial records may be retained where required. Unused purchased-token refund options are explained before confirmation.</p><label class="checkline" style="margin-top:16px"><input type="checkbox" id="deleteAck"><span>I understand this is permanent and contact information previously unlocked may become unavailable.</span></label><button class="btn btn-primary full-width" style="margin-top:14px" data-action="confirmDelete">Continue to final confirmation</button>`);
if(a==="confirmDelete"){if(!$("#deleteAck")?.checked){toast("Please confirm you understand the deletion consequences.");return}openModal(`<div class="eyebrow">Final confirmation</div><h2 id="modalTitle">Are you absolutely sure?</h2><p>This preview will not delete any real account. In the live product, reauthentication would be required here.</p><button class="btn btn-secondary full-width" data-action="closeModal">Keep my account</button>`)}
if(a==="privacy")openModal(`<div class="eyebrow">Privacy & safety</div><h2 id="modalTitle">Private by default.</h2><p>Moon & Muse won't display public country or location fields. Favorites and their notes are private. Contact information follows the creator's chosen access setting. Reports are reviewed with risk-based restrictions for credible serious concerns.</p>`);
if(a==="menu"){("#mobileNav").style.display=("#mobileNav").style.display==="block"?"none":"block"}
}
document.addEventListener("click",e=>{const b=e.target.closest("button");if(b){if(b.dataset.page){go(b.dataset.page);return}if(b.dataset.action){handleAction(b);return}if(b.dataset.category){$("#categoryFilter").value=b.dataset.category;go("directory");renderDirectory();return}}});
document.addEventListener("submit",e=>{e.preventDefault();if(e.target.id==="authForm"){const msg=$("#authMessage");msg.textContent="Preview sign-in complete. No account was created and no credentials were stored.";setTimeout(()=>{closeModal();if(currentAuthRole==="model"){go("dashboard");toast("Welcome to the interactive creator-studio preview.")}else{go("wallet");toast("Welcome to the client-account preview.")}},800)}if(e.target.id==="profileEditForm"){const p=profiles[0];p.name=$("#editName").value;p.tagline=("#editTagline").value;p.about=("#editAbout").value;p.languages=("#editLanguages").value;("#dashHeading").textContent="Changes saved in this preview";toast("Sample profile updated.");}if(e.target.id==="complimentForm"){const p=profiles.find(x=>x.id===Number(e.target.dataset.id)),contact=e.target.dataset.contact,key=p.id+":"+contact,chosen=[...e.target.querySelectorAll('input[name="tag"]:checked')].map(x=>x.value);if(!chosen.length){$("#complimentMessage").textContent="Choose at least one compliment tag.";return}if(complimented.has(key)){$("#complimentMessage").textContent="This purchase already has a compliment.";return}complimented.add(key);chosen.forEach(tag=>p.compliments[tag]=(p.compliments[tag]||0)+1);closeModal();openProfile(p.id);toast("Compliment submitted. Thank you for keeping it positive.")}if(e.target.id==="reportForm"){$("#reportMessage").textContent="Demo report submitted to the preview queue. No report was sent to a live service.";e.target.reset()}});
document.addEventListener("input",e=>{if(e.target.id==="searchInput"||e.target.id==="categoryFilter"||e.target.id==="sortFilter")renderDirectory();if(e.target.id==="favoriteSearch")renderFavorites();if(e.target.dataset.note){notes[e.target.dataset.note]=e.target.value}if(e.target.id==="profileVisibleSwitch"){profileVisible=e.target.checked;$("#hideProfileButton").textContent=profileVisible?"Hide profile":"Restore profile";toast(profileVisible?"Sample profile visible.":"Sample profile hidden.")}if(e.target.id==="showCompliments"){publicCounts=e.target.checked;$("#profileCompliments").innerHTML=Object.entries(currentProfile.compliments).map(([k,v])=>`<span class="pill">${k} · ${publicCounts?v:"—"}</span>`).join("")}});
$("#ageContinue").addEventListener("click",()=>{$("#ageGate").classList.add("hidden");toast("Age gate passed for this preview only.")});
$("#ageLeave").addEventListener("click",()=>{$("#ageGate").innerHTML='<div class="age-card"><div class="age-moon">☾</div><h2>You can’t enter yet.</h2><p>Moon & Muse is intended for adults aged 18 and over.</p></div>'});
$("#profileHeart").addEventListener("click",()=>{const n=currentProfile.id;if(saved.has(n)){saved.delete(n)}else saved.add(n);$("#profileHeart").textContent=saved.has(n)?"♥":"♡";$("#profileHeart").classList.toggle("saved",saved.has(n));toast(saved.has(n)?"Saved to private favorites.":"Removed from private favorites.")});
$$(".dash-nav").forEach(b=>b.addEventListener("click",()=>switchDash(b.dataset.dash)));
$("#modalBackdrop").addEventListener("click",e=>{if(e.target.id==="modalBackdrop")closeModal()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()});
renderCards("#featuredCreators",profiles.slice(0,3));renderDirectory();updateWallet();switchDash("overview");
</script>
