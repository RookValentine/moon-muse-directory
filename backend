from datetime import timedelta
from html import escape
from typing import Literal, Optional


from fastapi import APIRouter, Depends, HTTPException, Request, Response
from pydantic import BaseModel, Field
from starlette.concurrency import run_in_threadpool


from core import (db, current_member, require_admin, is_owner, clerk_lookup, sha, get_settings, audit, notify, ledger,
                  new_id, now, now_iso, OWNER_EMAIL, DEFAULT_SETTINGS, payments_mode)
from emailer import send_email, EMAIL_FROM_NAME
from storage import get_object


router = APIRouter(prefix="/api/admin")




# ---------- MFA (email one-time code) ----------
async def owner_only(request: Request, m: dict = Depends(current_member)) -> dict:
    if not is_owner(m):
        await audit(m, "admin.access_denied", request.url.path, request=request)
        raise HTTPException(403, "Not allowed")
    return m




@router.post("/mfa/request")
async def mfa_request(request: Request, m: dict = Depends(owner_only)):
    email, verified = await run_in_threadpool(clerk_lookup, m["user_id"])
    if email != OWNER_EMAIL or not verified:
        await audit(m, "admin.mfa_denied_email_mismatch", request=request)
        raise HTTPException(403, "Not allowed")
    last = await db.admin_mfa.find_one({"user_id": m["user_id"]}, {"_id": 0})
    if last and last["created_at"] > (now() - timedelta(seconds=60)).isoformat():
        raise HTTPException(429, "Please wait a minute before requesting another code")
    code = f"{secrets.randbelow(1_000_000):06d}"
    await db.admin_mfa.replace_one({"user_id": m["user_id"]}, {
        "user_id": m["user_id"], "code_hash": sha(m["user_id"] + code), "attempts": 0, "sid": m["sid"],
        "expires_at": (now() + timedelta(minutes=10)).isoformat(), "created_at": now_iso()}, upsert=True)
    html = (f'<table role="presentation" width="100%"><tr><td style="padding:28px;font-family:Georgia,serif;background:#120f18;color:#f4ecf7">'
            f'<p style="font-size:13px;letter-spacing:3px;color:#e9cb92">{escape(EMAIL_FROM_NAME).upper()} · OWNER PORTAL</p>'
            f'<p style="font-size:16px">Your one-time admin sign-in code is:</p>'
            f'<p style="font-size:34px;letter-spacing:10px;font-weight:bold;color:#c6a3f4">{code}</p>'
            f'<p style="font-size:13px;color:#b9adbf">Enter it on the admin sign-in screen. It expires in 10 minutes and works once. '
            f'If you did not try to sign in, secure your account and ignore this message.</p>'
            f'<p style="font-size:11px;color:#8e8296">Sent by {escape(EMAIL_FROM_NAME)}. We never ask for your password by email.</p>'
            f'</td></tr></table>')
    await send_email(to=OWNER_EMAIL, subject=f"{EMAIL_FROM_NAME} admin sign-in code", html=html)
    await audit(m, "admin.mfa_code_sent", request=request)
    return {"ok": True, "sent_to": OWNER_EMAIL[:3] + "•••" + OWNER_EMAIL[OWNER_EMAIL.index("@"):]}




class CodeIn(BaseModel):
    code: str = Field(pattern=r"^\d{6}$")




@router.post("/mfa/verify")
async def mfa_verify(body: CodeIn, request: Request, m: dict = Depends(owner_only)):
    rec = await db.admin_mfa.find_one({"user_id": m["user_id"]}, {"_id": 0})
    if not rec or rec["expires_at"] < now_iso() or rec["attempts"] >= 5 or rec["sid"] != m["sid"]:
        await audit(m, "admin.mfa_failed", details={"reason": "expired_or_locked"}, request=request)
        raise HTTPException(400, "Code expired or too many attempts. Request a new code.")
    if not secrets.compare_digest(rec["code_hash"], sha(m["user_id"] + body.code)):
        await db.admin_mfa.update_one({"user_id": m["user_id"]}, {"$inc": {"attempts": 1}})
        await audit(m, "admin.mfa_failed", details={"reason": "wrong_code"}, request=request)
        raise HTTPException(400, "Incorrect code")
    await db.admin_mfa.delete_one({"user_id": m["user_id"]})
    token = secrets.token_urlsafe(32)
    await db.admin_sessions.insert_one({"token_hash": sha(token), "user_id": m["user_id"], "sid": m["sid"],
                                        "expires_at": (now() + timedelta(hours=8)).isoformat(), "last_seen": now_iso(),
                                        "created_at": now_iso(), "ip": request.headers.get("x-forwarded-for", "")})
    await audit(m, "admin.mfa_success", request=request)
    return {"token": token}




