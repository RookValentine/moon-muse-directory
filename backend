class UploadInit(BaseModel):
    filename: str = Field(min_length=1, max_length=200)
    content_type: str
    size: int = Field(gt=0)
    purpose: Literal["preview", "content", "delivery"]




@router.post("/uploads")
async def upload_init(body: UploadInit, m: dict = Depends(creator_only)):
    await verified_profile(m)
    allowed = IMAGE_TYPES if body.purpose == "preview" else MEDIA_TYPES
    if body.content_type not in allowed:
        raise HTTPException(400, "Unsupported file type" + (" — previews must be images" if body.purpose == "preview" else ""))
    limit = VIDEO_MAX if body.content_type in VIDEO_TYPES else FILE_MAX
    if body.size > limit:
        raise HTTPException(400, f"File is larger than {limit // (1024 * 1024)} MB")
    uid = new_id()
    UPLOAD_DIR.mkdir(exist_ok=True)
    (UPLOAD_DIR / uid).write_bytes(b"")
    await db.uploads.insert_one({"id": uid, "user_id": m["user_id"], **body.model_dump(), "received": 0, "next_index": 0, "created_dt": now()})
    return {"upload_id": uid, "chunk_size": CHUNK_SIZE}




def _append(path: Path, data: bytes):
    with open(path, "ab") as fh:
        fh.write(data)




def _magic_ok(path: Path, ctype: str) -> bool:
    with open(path, "rb") as fh:
        h = fh.read(16)
    if ctype == "image/jpeg":
        return h[:3] == b"\xff\xd8\xff"
    if ctype == "image/png":
        return h[:8] == b"\x89PNG\r\n\x1a\n"
    if ctype == "image/webp":
        return h[:4] == b"RIFF" and h[8:12] == b"WEBP"
    if ctype == "application/pdf":
        return h[:4] == b"%PDF"
    if ctype in ("video/mp4", "video/quicktime", "audio/mp4", "audio/x-m4a"):
        return h[4:8] in (b"ftyp", b"moov", b"mdat", b"wide", b"free")
    if ctype == "video/webm":
        return h[:4] == b"\x1a\x45\xdf\xa3"
    if ctype in ("audio/wav", "audio/x-wav"):
        return h[:4] == b"RIFF" and h[8:12] == b"WAVE"
    if ctype == "audio/ogg":
        return h[:4] == b"OggS"
    if ctype == "audio/mpeg":
        return h[:3] == b"ID3" or (h[0] == 0xFF and h[1] & 0xE0 == 0xE0)
    return False




@router.put("/uploads/{uid}/{index}")
async def upload_chunk(uid: str, index: int, request: Request, m: dict = Depends(creator_only)):
    u = await db.uploads.find_one({"id": uid, "user_id": m["user_id"]}, {"_id": 0})
    if not u or index != u["next_index"]:
        raise HTTPException(409, "Upload not found or chunk out of order")
    data = await request.body()
    if not data or len(data) > CHUNK_SIZE or u["received"] + len(data) > u["size"]:
        raise HTTPException(400, "Invalid chunk")
    await run_in_threadpool(_append, UPLOAD_DIR / uid, data)
    await db.uploads.update_one({"id": uid}, {"$inc": {"received": len(data), "next_index": 1}})
    return {"received": u["received"] + len(data)}




@router.post("/uploads/{uid}/complete")
async def upload_complete(uid: str, m: dict = Depends(creator_only)):
    u = await db.uploads.find_one_and_delete({"id": uid, "user_id": m["user_id"]})
    path = UPLOAD_DIR / uid
    if not u or u["received"] != u["size"] or not path.exists():
        raise HTTPException(400, "Upload incomplete — please try again")
    if not await run_in_threadpool(_magic_ok, path, u["content_type"]):
        path.unlink(missing_ok=True)
        raise HTTPException(400, "The file contents don't match its type")
    fid = new_id()
    folder = "public/previews" if u["purpose"] == "preview" else "private/market"
    try:
        res = await run_in_threadpool(put_file, f"{APP_NAME}/{folder}/{m['user_id']}/{fid}.{MEDIA_TYPES[u['content_type']]}", str(path), u["content_type"])
    finally:
        path.unlink(missing_ok=True)
    doc = {"id": fid, "owner_id": m["user_id"], "purpose": u["purpose"], "storage_path": res["path"], "content_type": u["content_type"],
           "original_filename": u["filename"][:120], "size": u["size"], "is_deleted": False, "created_at": now_iso()}
    await db.files.insert_one(dict(doc))
    return {"id": fid, "content_type": doc["content_type"], "original_filename": doc["original_filename"], "size": doc["size"],
            "url": media_url(fid) if u["purpose"] == "preview" else ""}




