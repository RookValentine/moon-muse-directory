class UnlockIn(BaseModel):
    confirm: bool




@router.post("/creators/{creator_id}/contacts/{contact_id}/unlock")
async def unlock(creator_id: str, contact_id: str, body: UnlockIn, request: Request, m: dict = Depends(client_only)):
    if not body.confirm:
        raise HTTPException(400, "Unlock must be confirmed")
    c = await db.creators.find_one({"id": creator_id, **PUBLIC_QUERY}, {"_id": 0})
    contact = next((x for x in (c or {}).get("contacts", []) if x["id"] == contact_id), None)
    if not contact or contact["mode"] != "locked":
        raise HTTPException(404, "Contact not available for unlock")
    cost = int(contact["price"])
    w = m["wallet"]
    if w["promo"] + w["purchased"] < cost:
        raise HTTPException(402, "Not enough tokens")
    promo_use = min(w["promo"], cost)
    purch_use = cost - promo_use
    unlock_id = new_id()
    try:
        await db.unlocks.insert_one({"id": unlock_id, "client_id": m["user_id"], "creator_id": creator_id, "contact_id": contact_id,
                                     "creator_name": c["display_name"], "contact_name": contact["name"], "cost": cost,
                                     "complimented": False, "created_at": now_iso()})
    except DuplicateKeyError:
        raise HTTPException(409, "Already unlocked")
    r = await db.users.update_one({"user_id": m["user_id"], "wallet.promo": w["promo"], "wallet.purchased": {"$gte": purch_use}},
                                  {"$inc": {"wallet.promo": -promo_use, "wallet.purchased": -purch_use}})
    if not r.modified_count:
        await db.unlocks.delete_one({"id": unlock_id})
        raise HTTPException(409, "Your balance changed. Please try again.")
    demo_creator = c.get("is_demo") or not c.get("user_id")
    await ledger(m["user_id"], "unlock", f"Contact unlock · {c['display_name']}", purchased=-purch_use, promo=-promo_use,
                 mode="demo" if demo_creator else "live", ref=unlock_id)
    if not demo_creator and purch_use > 0:
        s = await get_settings()
        from datetime import timedelta
        from core import now
        await db.earnings.insert_one({"id": new_id(), "creator_user_id": c["user_id"], "unlock_id": unlock_id, "source": "unlock", "tokens": purch_use,
                                      "amount_usd": round(purch_use * s["token_usd_value"] * s["creator_share"], 2),
                                      "available_at": (now() + timedelta(days=s["hold_days"])).isoformat(),
                                      "payout_id": None, "created_at": now_iso()})
        await notify(c["user_id"], "New contact unlock", f"A patron unlocked “{contact['name']}” for {cost} tokens.")
    await audit(m, "tokens.unlock", unlock_id, {"creator_id": creator_id, "cost": cost}, request)
    wallet_now = (await db.users.find_one({"user_id": m["user_id"]}, {"_id": 0, "wallet": 1}))["wallet"]
    return {"ok": True, "value": contact["value"], "unlock_id": unlock_id, "wallet": wallet_now}




