class CheckoutIn(BaseModel):
    pack_id: str = Field(pattern=r"^[a-z0-9_-]+$")




@router.post("/wallet/checkout")
async def checkout(body: CheckoutIn, request: Request, m: dict = Depends(client_only)):
    pack = PACKS.get(body.pack_id)
    if not pack:
        raise HTTPException(400, "Unknown pack")
    mode = payments_mode()
    pct = await new_patron_discount(m["user_id"])
    order = {"id": new_id(), "user_id": m["user_id"], "pack_id": body.pack_id, "label": pack["label"],
             "tokens": pack["tokens"], "price": discounted(pack["price"], pct), "list_price": pack["price"], "discount_pct": pct,
             "status": "created", "mode": mode, "created_at": now_iso()}
    await db.orders.insert_one(dict(order))
    await audit(m, "payments.checkout_created", order["id"], {"pack": body.pack_id, "mode": mode}, request)
    if mode == "demo":
        return {"mode": "demo", "order_id": order["id"]}
    await db.orders.update_one({"id": order["id"]}, {"$set": {"status": "pending"}})
    return {"mode": "live", "order_id": order["id"], "checkout_url": ccbill_url(order)}




