class OnboardIn(BaseModel):
    role: Literal["client", "creator"]
    display_name: str = Field(min_length=2, max_length=40)
    dob: date
    accept_terms: bool
    referral_code: Optional[str] = Field(default=None, max_length=20)




@router.post("/me/onboard")
async def onboard(body: OnboardIn, request: Request, m: dict = Depends(current_member)):
    if m.get("role"):
        raise HTTPException(400, "Account already set up")
    s = await get_settings()
    if not s["registrations_open"]:
        raise HTTPException(403, "New registrations are paused. Please check back soon.")
    if not body.accept_terms:
        raise HTTPException(400, "Please accept the terms to continue")
    if age_from(body.dob) < 18:
        await db.users.update_one({"user_id": m["user_id"]}, {"$set": {"status": "ineligible"}})
        await audit(m, "account.age_ineligible", m["user_id"], request=request)
        raise HTTPException(403, "House Of Muses is only for adults aged 18 and over.")
    name = body.display_name.strip()
    assert_online_only(name)
    await db.users.update_one({"user_id": m["user_id"], "role": None}, {"$set": {
        "role": body.role, "display_name": name, "dob": body.dob.isoformat(), "terms_accepted_at": now_iso(),
        "wallet": {"purchased": 0, "promo": 0}, "onboarded_at": now_iso()}})
    if body.role == "creator":
        await db.creators.insert_one({
            "id": new_id(), "user_id": m["user_id"], "display_name": name, "tagline": "", "about": "",
            "category": "Adult Content Creator", "languages": "English", "tags": [], "photo_url": "", "contacts": [],
            "compliments": {t: 0 for t in COMPLIMENT_TAGS}, "show_compliment_counts": True,
            "verification_status": "unsubmitted", "visible": True, "moderation": "ok", "views": 0,
            "is_demo": False, "created_at": now_iso()})
    code = (body.referral_code or "").strip().upper()
    if code and body.role == "client":
        ref = await db.users.find_one({"referral_code": code, "status": "active", "role": "client"}, {"_id": 0, "user_id": 1})
        if ref and ref["user_id"] != m["user_id"]:
            await db.referrals.insert_one({"id": new_id(), "referrer_id": ref["user_id"], "referred_id": m["user_id"],
                                           "referred_role": body.role, "status": "pending", "created_at": now_iso()})
            await notify(ref["user_id"], "New referral", "Someone joined with your code. Rewards apply once they qualify.")
    await notify(m["user_id"], "Welcome to House Of Muses",
                 "Your account is ready." + (" Submit verification to publish your muse profile." if body.role == "creator" else ""))
    await audit(m, "account.onboarded", m["user_id"], {"role": body.role}, request)
    return me_out(await db.users.find_one({"user_id": m["user_id"]}, {"_id": 0}))




