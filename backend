@router.get("/content/{fid}")
async def content(fid: str, request: Request, u: str, e: int, s: str):
    if not verify_content_sig(fid, u, e, s):
        raise HTTPException(403, "This link has expired. Reopen the file from your library.")
    f = await db.files.find_one({"id": fid, "is_deleted": False}, {"_id": 0})
    if not f:
        raise HTTPException(404, "Not found")
    up = await run_in_threadpool(open_object, f["storage_path"])
    total = int(up.headers.get("Content-Length", f.get("size", 0)))
    base = {"Cache-Control": "private, no-store", "Content-Disposition": "inline", "X-Robots-Tag": "noindex", "Accept-Ranges": "bytes", "X-Content-Type-Options": "nosniff"}
    rng = re.match(r"bytes=(\d*)-(\d*)$", request.headers.get("range", ""))
    if not rng or not total or (not rng.group(1) and not rng.group(2)):
        return StreamingResponse(up.iter_content(512 * 1024), media_type=f["content_type"], headers={**base, "Content-Length": str(total)})
    if rng.group(1):
        start, end = int(rng.group(1)), min(int(rng.group(2) or total - 1), total - 1)
    else:
        start, end = max(total - int(rng.group(2)), 0), total - 1
    if start > end:
        up.close()
        raise HTTPException(416, "Range not satisfiable")


    def window():
        pos = 0
        for chunk in up.iter_content(512 * 1024):
            nxt = pos + len(chunk)
            if nxt > start:
                yield chunk[max(start - pos, 0): end + 1 - pos]
            pos = nxt
            if pos > end:
                break
        up.close()
    return StreamingResponse(window(), status_code=206, media_type=f["content_type"],
                             headers={**base, "Content-Range": f"bytes {start}-{end}/{total}", "Content-Length": str(end - start + 1)})




# ---------- paid messaging ----------
class SendIn(BaseModel):
    creator_id: str
    body: str = Field(min_length=1, max_length=2000)
    confirm: bool
    expected_price: Optional[int] = None




@router.post("/messages")
async def send_message(body: SendIn, request: Request, m: dict = Depends(client_only)):
    c = await db.creators.find_one({"id": body.creator_id, **PUBLIC_QUERY}, {"_id": 0})
    msg = (c or {}).get("messaging") or {}
    if not c or c.get("is_demo") or not msg.get("enabled"):
        raise HTTPException(400, "This muse isn't accepting messages right now")
    if not body.confirm:
        raise HTTPException(400, "Message cost must be confirmed")
    text = body.body.strip()
    assert_online_only(text)
    price = int(msg["price"])
    if body.expected_price is not None and body.expected_price != price:
        raise HTTPException(409, f"This muse's message price changed to {price} tokens. Please confirm again.")
    promo, purch = await spend_tokens(m["user_id"], price)
    try:
        t = await db.threads.find_one_and_update(
            {"client_id": m["user_id"], "creator_id": c["id"]},
            {"$setOnInsert": {"id": new_id(), "client_name": m.get("display_name", ""), "creator_user_id": c["user_id"], "creator_name": c["display_name"],
                              "created_at": now_iso()},
             "$set": {"last_body": text[:120], "last_at": now_iso()}, "$inc": {"unread_creator": 1}}, upsert=True, return_document=True)
        mid = new_id()
        await db.messages.insert_one({"id": mid, "thread_id": t["id"], "sender": "client", "body": text, "cost": price, "created_at": now_iso()})
    except Exception:
        await db.users.update_one({"user_id": m["user_id"]}, {"$inc": {"wallet.promo": promo, "wallet.purchased": purch}})
        raise HTTPException(500, "Message could not be sent. Your tokens were not spent.")
    await ledger(m["user_id"], "message", f"Message · {c['display_name']}", purchased=-purch, promo=-promo, ref=mid)
    await add_earning(c["user_id"], purch, "message", mid)
    await notify(c["user_id"], "New paid message", f"{m.get('display_name') or 'A patron'} sent you a message.")
    await audit(m, "message.sent", t["id"], {"cost": price}, request)
    return {"ok": True, "thread_id": t["id"]}




def thread_filter(m: dict) -> dict:
    if m["role"] == "client":
        return {"client_id": m["user_id"]}
    if m["role"] == "creator":
        return {"creator_user_id": m["user_id"]}
    raise HTTPException(403, "Not available")




@router.get("/threads")
async def threads(m: dict = Depends(active_member)):
    return await db.threads.find(thread_filter(m), {"_id": 0}).sort("last_at", -1).to_list(200)




@router.get("/threads/{tid}")
async def thread(tid: str, m: dict = Depends(active_member)):
    t = await db.threads.find_one({"id": tid, **thread_filter(m)}, {"_id": 0})
    if not t:
        raise HTTPException(404, "Conversation not found")
    await db.threads.update_one({"id": tid}, {"$set": {"unread_client" if m["role"] == "client" else "unread_creator": 0}})
    msgs = await db.messages.find({"thread_id": tid}, {"_id": 0}).sort("created_at", 1).to_list(500)
    c = await db.creators.find_one({"id": t["creator_id"]}, {"_id": 0, "messaging": 1, "photo_url": 1})
    return {"thread": t, "messages": msgs, "messaging": (c or {}).get("messaging") or {"enabled": False}, "photo_url": (c or {}).get("photo_url", "")}




