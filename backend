    description: str = Field(default="", max_length=2000)
    price: int = Field(ge=0, le=5000)
    preview_file_ids: List[str] = Field(default_factory=list, max_length=6)
    content_file_ids: List[str] = Field(default_factory=list, max_length=40)
    delivery_days: int = Field(default=7, ge=1, le=30)
    consent: bool




@router.post("/listings")
async def create_listing(body: ListingIn, request: Request, m: dict = Depends(creator_only)):
    c = await verified_profile(m)
    if not body.consent:
        raise HTTPException(400, "Please confirm the consent and content declaration")
    kind = KINDS[body.kind]
    if body.price == 0 and body.kind != "sex_ed":
        raise HTTPException(400, "Only sex education posts can be free")
    if body.kind == "custom":
        if body.content_file_ids:
            raise HTTPException(400, "Custom listings are delivered after purchase")
    elif not 1 <= len(body.content_file_ids) <= kind["max_files"]:
        raise HTTPException(400, f"{kind['label']} needs between 1 and {kind['max_files']} files")
    assert_online_only(body.title, body.description)
    await owned_files(m, body.preview_file_ids, "preview")
    for f in await owned_files(m, body.content_file_ids, "content"):
        if f["content_type"] not in kind["types"]:
            raise HTTPException(400, f"{f['original_filename']} isn't allowed in a {kind['label'].lower()}")
    lid = new_id()
    await db.listings.insert_one({
        **body.model_dump(exclude={"consent"}), "id": lid, "creator_id": c["id"], "creator_user_id": m["user_id"],
        "creator_name": c["display_name"], "status": "live", "review_status": "unreviewed",
        "review_priority": 2 if body.kind == "custom" else 1, "sales": 0, "consent_at": now_iso(), "created_at": now_iso()})
    await audit(m, "listing.created", lid, {"kind": body.kind, "price": body.price}, request)
    return {"id": lid}




