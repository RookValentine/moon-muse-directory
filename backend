@router.post("/ccbill/postback")
async def ccbill_postback(request: Request):
    if not ccbill_ready():
        raise HTTPException(404)
    p = await read_postback(request)
    if str(p.get("clientAccnum", "")) != os.environ["CCBILL_CLIENT_ACCNUM"] or \
       str(p.get("clientSubacc", "")) != os.environ["CCBILL_CLIENT_SUBACC"]:
        raise HTTPException(400, "account mismatch")
    event = str(p.get("eventType", p.get("event", "")))
    approved = str(p.get("approved", "")) in {"1", "true", "True"}
    order_id = str(p.get("x_order_id", ""))
    txn_id = str(p.get("transactionId", p.get("subscriptionId", "")))
    await audit(None, "payments.postback", order_id, {"event": event, "approved": approved}, request)
    if event == "NewSaleFailure" and order_id:
        await db.orders.update_one({"id": order_id, "status": "pending"}, {"$set": {"status": "failed"}})
        return {"ok": True}
    if not order_id or not txn_id or not (event == "NewSaleSuccess" or approved):
        return {"ok": True, "ignored": True}
    order = await db.orders.find_one({"id": order_id}, {"_id": 0})
    if not order or money(str(p.get("initialPrice", order["price"]))) != order["price"]:
        raise HTTPException(400, "unknown order or amount mismatch")
    await fulfill_order(order_id, txn_id, "live")
    return {"ok": True}
