@router.post("/reports")
async def report(body: ReportIn, request: Request, m: dict = Depends(active_member)):
    if body.reason not in REPORT_REASONS:
        raise HTTPException(400, "Choose a valid reason")
    if not await db.creators.find_one({"id": body.creator_id}, {"_id": 1}):
        raise HTTPException(404, "Profile not found")
