class BuyIn(BaseModel):
    confirm: bool
    expected_price: Optional[int] = None
    request_note: Optional[str] = Field(default=None, max_length=1000)




@router.post("/listings/{lid}/buy")
async def buy(lid: str, body: BuyIn, request: Request, m: dict = Depends(client_only)):
    if not body.confirm:
        raise HTTPException(400, "Purchase must be confirmed")
    l = await db.listings.find_one({"id": lid, "status": "live"}, {"_id": 0})
    if not l or not await public_creator_map([l["creator_id"]]):
        raise HTTPException(404, "Listing not available")
    if l["price"] == 0:
        raise HTTPException(400, "This post is free — just open it")
    if body.expected_price is not None and body.expected_price != l["price"]:
        raise HTTPException(409, f"The price changed to {l['price']} tokens. Please review and confirm again.")
    custom = l["kind"] == "custom"
    note = (body.request_note or "").strip()
    if custom:
        if len(note) < 10:
            raise HTTPException(400, "Describe your request in at least 10 characters")
        assert_online_only(note)
    pid = new_id()
    doc = {"id": pid, "listing_id": lid, "client_id": m["user_id"], "client_name": m.get("display_name", ""),
           "creator_user_id": l["creator_user_id"], "creator_id": l["creator_id"], "creator_name": l["creator_name"],
           "kind": l["kind"], "title": l["title"], "price": l["price"], "created_at": now_iso()}
    if custom:
        from datetime import timedelta
        doc.update({"status": "awaiting_delivery", "request_note": note,
                    "due_at": (now() + timedelta(days=l.get("delivery_days") or 7)).isoformat()})
    else:
        doc.update({"status": "paid", "unique_key": f"{lid}:{m['user_id']}"})
    try:
        await db.purchases.insert_one(dict(doc, promo_used=0, purchased_used=0))
    except DuplicateKeyError:
        raise HTTPException(409, "You already own this")
    try:
        promo, purch = await spend_tokens(m["user_id"], l["price"])
    except HTTPException:
        await db.purchases.delete_one({"id": pid})
        raise
    await db.purchases.update_one({"id": pid}, {"$set": {"promo_used": promo, "purchased_used": purch}})
    await db.listings.update_one({"id": lid}, {"$inc": {"sales": 1}})
    await ledger(m["user_id"], "purchase_content", f"{KINDS[l['kind']]['label']} · {l['title']}", purchased=-purch, promo=-promo, ref=pid)
    if not custom:
        await add_earning(l["creator_user_id"], purch, "sale", pid)
        await notify(l["creator_user_id"], "New sale", f"A patron bought “{l['title']}” for {l['price']} tokens.")
    else:
        await notify(l["creator_user_id"], "New custom order", f"A patron ordered “{l['title']}”. Deliver it from your studio.")
    await audit(m, "listing.purchased", pid, {"listing": lid, "price": l["price"]}, request)
    wallet = (await db.users.find_one({"user_id": m["user_id"]}, {"_id": 0, "wallet": 1}))["wallet"]
    return {"ok": True, "purchase_id": pid, "wallet": wallet}




